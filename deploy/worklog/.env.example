# 전용 합성 공개 데모만 사용. 실제 값은 Git 밖 .env에 저장하고 chmod 600 적용.
# 기존 로컬·다른 서비스의 자격을 재사용하지 않으며 역할마다 다른 난수를 지정한다.
POSTGRES_PASSWORD=CHANGE_ME_DEMO_POSTGRES
TNA_MIGRATION_DB_PASSWORD=CHANGE_ME_DEMO_MIGRATION
TNA_APP_DB_PASSWORD=CHANGE_ME_DEMO_APP
TNA_AUTH_DB_PASSWORD=CHANGE_ME_DEMO_AUTH
TNA_OPERATOR_DB_PASSWORD=CHANGE_ME_DEMO_UNUSED_OPERATOR

# 빈 값은 Compose 검증에서 거부한다. 실제 backend 요청의 Docker gateway IP 하나만
# 정규식으로 이스케이프해 넣는다. 전체 private IP 대역이나 .*를 신뢰하지 않는다.
# Compose .env의 single quote로 backslash와 $ 문자를 그대로 보존한다.
SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=
WORKLOG_IMAGE_TAG=public-demo
