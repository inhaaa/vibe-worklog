# Copy to .env and set five different, randomly generated local-only passwords.
# Empty placeholders intentionally prevent Docker Compose from starting.
POSTGRES_PASSWORD=
TNA_MIGRATION_DB_PASSWORD=
TNA_APP_DB_PASSWORD=
TNA_AUTH_DB_PASSWORD=
TNA_OPERATOR_DB_PASSWORD=
# Operator UI is disabled in compose.yaml. Enable only with compose.operator.yaml.
